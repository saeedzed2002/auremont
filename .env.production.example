# Public host and TLS settings
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
DJANGO_HTTP_PORT=80
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
# Set either value to true only after every relevant subdomain serves HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# PostgreSQL is private to the Compose network.
POSTGRES_DB=auremont
POSTGRES_USER=auremont
POSTGRES_PASSWORD=replace-with-a-strong-production-database-password

# Production email
DEFAULT_FROM_EMAIL=no-reply@your-domain.example
SERVER_EMAIL=errors@your-domain.example
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.your-provider.example
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=true

# Optional Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gunicorn worker count should be sized for the deployment host.
GUNICORN_WORKERS=3
