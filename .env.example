# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL / Docker Compose
POSTGRES_DB=auremont
POSTGRES_USER=auremont
POSTGRES_PASSWORD=replace-this-local-database-password
POSTGRES_PORT=5432

# Django database connection
DATABASE_URL=postgresql://auremont:replace-this-local-database-password@127.0.0.1:5432/auremont
